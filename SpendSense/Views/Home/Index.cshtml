@model List<SpendSense.Models.Transaction>

@{
    ViewData["Title"] = "Dashboard";
}

<div class="dashboard-page">

    <div class="dashboard-hero">
        <div>
            <span class="dashboard-kicker">Financial Overview</span>
            <h1>Welcome back, @ViewBag.Username 👋</h1>
            <p>Here is a quick overview of your income, expenses, bills, budgets and accounts.</p>
        </div>

        <a asp-controller="Transaction"
               asp-action="Create"
               class="btn btn-primary dashboard-hero-btn">
            <i class="bi bi-plus-circle"></i>
            Add Transaction
        </a>
    </div>

    <div class="dashboard-grid mb-4">

        <div class="stat-card stat-income">
            <div class="stat-icon">
                <i class="bi bi-arrow-down-circle"></i>
            </div>
            <div>
                <p>Total Income</p>
                <h3>₺ @ViewBag.TotalIncome</h3>
            </div>
        </div>

        <div class="stat-card stat-expense">
            <div class="stat-icon">
                <i class="bi bi-arrow-up-circle"></i>
            </div>
            <div>
                <p>Total Expense</p>
                <h3>₺ @ViewBag.TotalExpense</h3>
            </div>
        </div>

        <div class="stat-card stat-balance">
            <div class="stat-icon">
                <i class="bi bi-wallet2"></i>
            </div>
            <div>
                <p>Net Balance</p>
                <h3>₺ @ViewBag.Balance</h3>
            </div>
        </div>

        <div class="stat-card stat-account">
            <div class="stat-icon">
                <i class="bi bi-bank"></i>
            </div>
            <div>
                <p>Accounts Balance</p>
                <h3>₺ @ViewBag.AccountBalance</h3>
            </div>
        </div>

    </div>

    <div class="dashboard-mini-grid mb-4">

        <div class="mini-card">
            <span><i class="bi bi-arrow-left-right"></i></span>
            <div>
                <p>Transactions</p>
                <h4>@ViewBag.TransactionCount</h4>
            </div>
        </div>

        <div class="mini-card">
            <span><i class="bi bi-bank"></i></span>
            <div>
                <p>Accounts</p>
                <h4>@ViewBag.AccountCount</h4>
            </div>
        </div>

        <div class="mini-card">
            <span><i class="bi bi-receipt"></i></span>
            <div>
                <p>Unpaid Bills</p>
                <h4>@ViewBag.UnpaidBills</h4>
            </div>
        </div>

        <div class="mini-card">
            <span><i class="bi bi-check-circle"></i></span>
            <div>
                <p>Paid Bills</p>
                <h4>@ViewBag.PaidBills</h4>
            </div>
        </div>

        <div class="mini-card">
            <span><i class="bi bi-wallet"></i></span>
            <div>
                <p>Budgets</p>
                <h4>@ViewBag.BudgetCount</h4>
            </div>
        </div>

    </div>

    <div class="dashboard-actions mb-4">
        <a asp-controller="Transaction" asp-action="Index">
            <i class="bi bi-arrow-left-right"></i>
            Transactions
        </a>

        <a asp-controller="Account" asp-action="Index">
            <i class="bi bi-bank"></i>
            Accounts
        </a>

        <a asp-controller="Budget" asp-action="Index">
            <i class="bi bi-wallet2"></i>
            Budgets
        </a>

        <a asp-controller="Bill" asp-action="Index">
            <i class="bi bi-receipt"></i>
            Bills
        </a>
    </div>

    <div class="table-container dashboard-table">

        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h4 class="fw-bold mb-1">Recent Transactions</h4>
                <p class="text-muted mb-0">Your latest financial activity.</p>
            </div>

            <a asp-controller="Transaction"
                   asp-action="Index"
                   class="btn btn-outline-primary btn-sm">
                View All
            </a>
        </div>

        @if (!Model.Any())
        {
            <div class="alert alert-info mb-0">
                No transactions found.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>Title</th>
                            <th>Category</th>
                            <th>Account</th>
                            <th>Type</th>
                            <th>Amount</th>
                            <th>Date</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <strong>@item.Title</strong>
                                </td>

                                <td>@item.Category</td>

                                <td>
                                    @(item.Account != null ? item.Account.Name : "-")
                                </td>

                                <td>
                                    @if (item.TransactionType == "Income")
                                    {
                                        <span class="badge bg-success">Income</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Expense</span>
                                    }
                                </td>

                                <td class="fw-bold">
                                    ₺ @item.Amount
                                </td>

                                <td>
                                    @item.Date.ToString("yyyy-MM-dd")
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

    </div>

</div>