@model List<SpendSense.Models.Budget>

@{
    ViewData["Title"] = "Budgets";
}

<div class="page-header-modern">
    <div>
        <h2>Budgets</h2>
        <p>Manage your spending limits and compare them with real expenses.</p>
    </div>

    <a asp-controller="Budget"
           asp-action="Create"
           class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Create Budget
    </a>
</div>

<div class="table-container">

    @if (!Model.Any())
    {
        <div class="alert alert-info mb-0">
            No budgets found.
        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="table align-middle modern-table">
                <thead>
                    <tr>
                        <th>Category</th>
                        <th>Limit</th>
                        <th>Spent</th>
                        <th>Remaining</th>
                        <th>Progress</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <strong>@item.Category</strong>

                                @if (!string.IsNullOrWhiteSpace(item.Description))
                                {
                                    <div class="text-muted small">
                                        @item.Description
                                    </div>
                                }
                            </td>

                            <td class="fw-bold">
                                ₺ @item.LimitAmount
                            </td>

                            <td class="fw-bold text-danger">
                                ₺ @item.SpentAmount
                            </td>

                            <td class="fw-bold @(item.RemainingAmount < 0 ? "text-danger" : "text-success")">
                                ₺ @item.RemainingAmount
                            </td>

                            <td style="min-width: 240px;">
                                <div class="budget-progress-info">
                                    <span>@item.ProgressPercentage%</span>
                                </div>

                                <div class="progress budget-progress">
                                    <div class="progress-bar bg-@item.FillClass"
                                         role="progressbar"
                                         style="width:@Math.Min(item.ProgressPercentage, 100)%">
                                    </div>
                                </div>
                            </td>

                            <td>
                                <span class="budget-status-pill budget-status-@item.FillClass">
                                    @item.StatusText
                                </span>
                            </td>

                            <td class="text-end">
                                <div class="action-group">
                                    <a asp-action="Details"
                                           asp-route-id="@item.Id"
                                           class="btn btn-outline-dark btn-sm">
                                        Details
                                    </a>

                                    <a asp-action="Edit"
                                           asp-route-id="@item.Id"
                                           class="btn btn-outline-primary btn-sm">
                                        Edit
                                    </a>

                                    <a asp-action="Delete"
                                           asp-route-id="@item.Id"
                                           class="btn btn-outline-danger btn-sm"
                                           onclick="return confirm('Are you sure you want to delete this budget?');">
                                        Delete
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

        </div>
    }

</div>