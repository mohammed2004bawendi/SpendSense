@model List<SpendSense.Models.Bill>

@{
    ViewData["Title"] = "Bills";
}

<div class="page-header-modern">
    <div>
        <h2>Bills</h2>
        <p>Manage monthly payments, due days and paid status.</p>
    </div>

    <a asp-controller="Bill"
           asp-action="Create"
           class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Create Bill
    </a>
</div>

<div class="table-container">

    @if (!Model.Any())
    {
        <div class="alert alert-info mb-0">
            No bills found.
        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="table align-middle modern-table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Amount</th>
                        <th>Due Day</th>
                        <th>Account</th>
                        <th>Status</th>
                        <th>Paid Date</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <strong>@item.Name</strong>
                            </td>

                            <td class="fw-bold">
                                ₺ @item.Amount
                            </td>

                            <td>
                                <span class="bill-due-pill">
                                    Day @item.DueDay
                                </span>
                            </td>

                            <td>
                                @(item.Account != null ? item.Account.Name : "-")
                            </td>

                            <td>
                                @if (item.Paid)
                                {
                                    <span class="bill-status-pill bill-status-paid">
                                        <i class="bi bi-check-circle"></i> Paid
                                    </span>
                                }
                                else
                                {
                                    <span class="bill-status-pill bill-status-unpaid">
                                        <i class="bi bi-clock"></i> Unpaid
                                    </span>
                                }
                            </td>

                            <td>
                                @if (item.PaidDate != null)
                                {
                                    @item.PaidDate.Value.ToShortDateString()
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>

                            <td class="text-end">
                                <div class="action-group">
                                    <a asp-action="Details"
                                           asp-route-id="@item.Id"
                                           class="btn btn-outline-dark btn-sm">
                                        Details
                                    </a>

                                    <a asp-action="Edit"
                                           asp-route-id="@item.Id"
                                           class="btn btn-outline-primary btn-sm">
                                        Edit
                                    </a>

                                    <a asp-action="Delete"
                                           asp-route-id="@item.Id"
                                           class="btn btn-outline-danger btn-sm"
                                           onclick="return confirm('Are you sure you want to delete this bill?');">
                                        Delete
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

        </div>
    }

</div>