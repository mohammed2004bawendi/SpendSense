@model SpendSense.Models.Bill

@{
    ViewData["Title"] = "Bill Details";
}

<div class="page-header-modern">
    <div>
        <h2>Bill Details</h2>
        <p>View bill amount, account, due day and payment information.</p>
    </div>

    <a asp-controller="Bill"
           asp-action="Index"
           class="btn btn-outline-light">
        ← Back
    </a>
</div>

<div class="modern-panel">

    <div class="row g-4">

        <div class="col-md-6">
            <span class="details-label">Bill Name</span>
            <div class="details-info-card">
                <strong>@Model.Name</strong>
            </div>
        </div>

        <div class="col-md-6">
            <span class="details-label">Amount</span>
            <div class="details-info-card">
                <strong class="fs-4">₺ @Model.Amount</strong>
            </div>
        </div>

        <div class="col-md-6">
            <span class="details-label">Due Day</span>
            <div class="details-info-card">
                Day @Model.DueDay
            </div>
        </div>

        <div class="col-md-6">
            <span class="details-label">Payment Account</span>
            <div class="details-info-card">
                @(Model.Account != null ? Model.Account.Name : "No Account")
            </div>
        </div>

        <div class="col-md-6">
            <span class="details-label">Payment Status</span>
            <div class="details-info-card">
                @if (Model.Paid)
                {
                    <span class="bill-status-pill bill-status-paid">
                        <i class="bi bi-check-circle"></i> Paid
                    </span>
                }
                else
                {
                    <span class="bill-status-pill bill-status-unpaid">
                        <i class="bi bi-clock"></i> Unpaid
                    </span>
                }
            </div>
        </div>

        <div class="col-md-6">
            <span class="details-label">Paid Date</span>
            <div class="details-info-card">
                @if (Model.PaidDate != null)
                {
                    @Model.PaidDate.Value.ToShortDateString()
                }
                else
                {
                    <span class="text-muted">Not Paid Yet</span>
                }
            </div>
        </div>

    </div>

    <div class="d-flex gap-3 mt-4">
        <a asp-controller="Bill"
               asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-primary">
            Edit Bill
        </a>

        <a asp-controller="Bill"
               asp-action="Delete"
               asp-route-id="@Model.Id"
               class="btn btn-outline-danger"
               onclick="return confirm('Are you sure you want to delete this bill?');">
            Delete
        </a>
    </div>

</div>