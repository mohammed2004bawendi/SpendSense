@model SpendSense.Models.Bill

@{
    ViewData["Title"] = "Edit Bill";
}

<div class="page-header-modern">
    <div>
        <h2>Edit Bill</h2>
        <p>Update bill amount, due day, account and payment status.</p>
    </div>

    <a asp-action="Index" class="btn btn-outline-light">
        Back to List
    </a>
</div>

<div class="modern-panel modern-form-card">

    <form asp-action="Edit" method="post">

        <input type="hidden" asp-for="Id" />

        <div class="row g-3">

            <div class="col-md-6">
                <label class="form-label">Bill Name</label>
                <input asp-for="Name"
                       class="form-control"
                       required />
            </div>

            <div class="col-md-6">
                <label class="form-label">Amount</label>
                <input asp-for="Amount"
                       type="number"
                       step="0.01"
                       class="form-control"
                       required />
            </div>

            <div class="col-md-6">
                <label class="form-label">Due Day</label>
                <input asp-for="DueDay"
                       type="number"
                       min="1"
                       max="31"
                       class="form-control"
                       required />
            </div>

            <div class="col-md-6">
                <label class="form-label">Payment Account</label>
                <select asp-for="AccountId"
                        asp-items="ViewBag.Accounts"
                        class="form-select">
                    <option value="">Select account</option>
                </select>
                <small class="text-muted">Required if you mark the bill as paid.</small>
            </div>

            <div class="col-md-6">
                <label class="form-label">Payment Status</label>

                <div class="modern-check-card">
                    <input asp-for="Paid"
                           class="form-check-input"
                           type="checkbox" />

                    <label class="form-check-label">
                        Mark as Paid
                    </label>
                </div>
            </div>

            <div class="col-md-6">
                <label class="form-label">Paid Date</label>
                <input asp-for="PaidDate"
                       type="date"
                       class="form-control" />
            </div>

        </div>

        <div class="d-flex justify-content-end gap-2 mt-4">
            <a asp-action="Index" class="btn btn-outline-secondary">
                Cancel
            </a>

            <button type="submit" class="btn btn-primary">
                Update Bill
            </button>
        </div>

    </form>

</div>