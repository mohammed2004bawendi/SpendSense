@model List<TransactionDto>

@{
    ViewData["Title"] = "Transactions";
}

<div class="page-header-modern">
    <div>
        <h2>Transactions</h2>
        <p>Manage, search and filter your financial records.</p>
    </div>

    <a asp-controller="Transaction"
           asp-action="Create"
           class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Create Transaction
    </a>
</div>

<div class="modern-panel filter-card mb-4">
    <form method="get" asp-action="Index">
        <div class="row g-3 align-items-end">

            <div class="col-md-3">
                <label class="form-label">Search</label>
                <input type="text"
                       name="keyword"
                       value="@ViewBag.Keyword"
                       class="form-control"
                       placeholder="Title, category, account, notes..." />
            </div>

            <div class="col-md-2">
                <label class="form-label">Type</label>
                <select name="type" class="form-select">
                    <option value="">All</option>
                    <option value="Income" selected="@(ViewBag.Type == "Income")">Income</option>
                    <option value="Expense" selected="@(ViewBag.Type == "Expense")">Expense</option>
                </select>
            </div>

            <div class="col-md-2">
                <label class="form-label">Category</label>
                <input type="text"
                       name="category"
                       value="@ViewBag.Category"
                       class="form-control"
                       placeholder="Food, Salary..." />
            </div>

            <div class="col-md-2">
                <label class="form-label">Account</label>
                <select name="accountId"
                        asp-items="ViewBag.Accounts"
                        class="form-select">
                    <option value="">All Accounts</option>
                </select>
            </div>

            <div class="col-md-1">
                <label class="form-label">From</label>
                <input type="date"
                       name="startDate"
                       value="@ViewBag.StartDate"
                       class="form-control" />
            </div>

            <div class="col-md-1">
                <label class="form-label">To</label>
                <input type="date"
                       name="endDate"
                       value="@ViewBag.EndDate"
                       class="form-control" />
            </div>

            <div class="col-md-1 d-grid">
                <button type="submit" class="btn btn-dark">
                    Filter
                </button>
            </div>

        </div>

        <div class="mt-3">
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                Clear Filters
            </a>
        </div>
    </form>
</div>

<div class="table-container">

    @if (!Model.Any())
    {
        <div class="alert alert-info mb-0">
            No transactions found.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle modern-table">
                <thead>
                    <tr>
                        <th>Receipt</th>
                        <th>Title</th>
                        <th>Type</th>
                        <th>Category</th>
                        <th>Account</th>
                        <th>Amount</th>
                        <th>Date</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                @if (item.HasReceipt)
                                {
                                    <img src="@Url.Action("ReceiptImage", "Transaction", new { id = item.Id })"
                                         alt="Receipt"
                                         class="transaction-thumb" />
                                }
                                else
                                {
                                    <span class="no-image-pill">No Image</span>
                                }
                            </td>

                            <td>
                                <strong>@item.Title</strong>

                                @if (!string.IsNullOrWhiteSpace(item.Notes))
                                {
                                    <div class="text-muted small">@item.Notes</div>
                                }
                            </td>

                            <td>
                                @if (item.TransactionType == "Income")
                                {
                                    <span class="badge bg-success">Income</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Expense</span>
                                }
                            </td>

                            <td>@item.Category</td>

                            <td>
                                @(item.AccountName ?? "-")
                            </td>

                            <td class="fw-bold">
                                ₺ @item.Amount
                            </td>

                            <td>
                                @item.Date.ToString("yyyy-MM-dd")
                            </td>

                            <td class="text-end">
                                <div class="action-group">
                                    <a asp-action="Details"
                                           asp-route-id="@item.Id"
                                           class="btn btn-outline-dark btn-sm">
                                        Details
                                    </a>

                                    <a asp-action="Edit"
                                           asp-route-id="@item.Id"
                                           class="btn btn-outline-primary btn-sm">
                                        Edit
                                    </a>

                                    <a asp-action="Delete"
                                           asp-route-id="@item.Id"
                                           class="btn btn-outline-danger btn-sm"
                                           onclick="return confirm('Are you sure you want to delete this transaction?');">
                                        Delete
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>