@model SpendSense.Models.Account

@{
    ViewData["Title"] = "Account Details";
}

<div class="page-header-modern">
    <div>
        <h2>Account Details</h2>
        <p>View account type and current balance.</p>
    </div>

    <a asp-controller="Account"
           asp-action="Index"
           class="btn btn-outline-light">
        ← Back
    </a>
</div>

<div class="modern-panel">

    <div class="row g-4">

        <div class="col-md-6">
            <span class="details-label">Account Name</span>
            <div class="details-info-card">
                <strong>@Model.Name</strong>
            </div>
        </div>

        <div class="col-md-6">
            <span class="details-label">Account Type</span>
            <div class="details-info-card">
                @if (Model.AccountType == "Bank")
                {
                    <span class="account-type-pill account-bank">
                        <i class="bi bi-bank"></i> Bank
                    </span>
                }
                else if (Model.AccountType == "Cash")
                {
                    <span class="account-type-pill account-cash">
                        <i class="bi bi-cash-stack"></i> Cash
                    </span>
                }
                else
                {
                    <span class="account-type-pill account-card">
                        <i class="bi bi-credit-card"></i> Credit Card
                    </span>
                }
            </div>
        </div>

        <div class="col-md-12">
            <span class="details-label">Current Balance</span>
            <div class="details-info-card account-balance-highlight">
                <strong>₺ @Model.Balance</strong>
            </div>
        </div>

    </div>

    <div class="d-flex gap-3 mt-4">
        <a asp-controller="Account"
               asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-primary">
            Edit Account
        </a>

        <a asp-controller="Account"
               asp-action="Delete"
               asp-route-id="@Model.Id"
               class="btn btn-outline-danger"
               onclick="return confirm('Are you sure you want to delete this account?');">
            Delete
        </a>
    </div>

</div>